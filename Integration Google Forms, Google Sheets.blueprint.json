            "id": 12,
            "module": "gemini-ai:simpleTextPrompt",
            "version": 1,
            "parameters": {},
            "mapper": {
                "model": "gemini-3-flash-preview",
                "textPrompt": "Você é um sistema que retorna apenas JSON válido.\r\nAnalise o feedback e responda SOMENTE com JSON válido.\r\nNão escreva explicações.\r\nNão use markdown.\r\nNão use ```json.\r\nO campo score deve ser um número entre 1 e 10 usando ponto decimal quando necessário (exemplo: 7.5).\r\nInclua uma sugestão de ação de negócio clara e mensurável (ex: \"Aumentar suporte para reduzir churn em 10%\").\r\nFormato obrigatório:\r\n{\r\n  \"sentimento\": \"positivo | neutro | negativo\",\r\n  \"score\": 0,\r\n  \"insight\": \"resumo curto\",\r\n  \"sugestao_acao\": \"ação de negócio clara e mensurável\",\r\n  \"data_analise\": \"data da análise aleatória feita pela IA\"\r\n}\r\nFeedback:\r\n{{11.`4`}}  <!-- Ajuste para o nome exato da coluna -->"
            },
            "metadata": {
                "designer": {
                    "x": 235,
                    "y": 5
                },
                "restore": {
                    "expect": {
                        "model": {
                            "label": "Gemini 3 Flash PreviewBuilt for speed, scale, and frontier intelligence"
